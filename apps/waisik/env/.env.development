# 变量必须以 VITE_ 为前缀才能暴露给外部读取
NODE_ENV = 'development'

# 应用标题
VITE_APP_TITLE = 'Waisik'

# 应用端口
VITE_APP_PORT = 9000

# 公共基础路径
VITE_APP_PUBLIC_BASE = '/'

# 是否去除console 和 debugger
VITE_DELETE_CONSOLE = false

# 是否开启sourcemap
VITE_SHOW_SOURCEMAP = false

# 后台请求地址
VITE_SERVER_BASEURL = 'http://localhost:3000'

# 是否启用代理
VITE_APP_PROXY_ENABLE = false

# 代理前缀
VITE_APP_PROXY_PREFIX = '/api'

# 是否复制原生资源（仅 app 平台）
VITE_COPY_NATIVE_RES_ENABLE = false

# 高德地图 Web 服务 API Key
# 获取方式：https://lbs.amap.com/ -> 控制台 -> 应用管理 -> 我的应用 -> 创建新应用 -> 添加 Key（选择 Web 服务）
VITE_AMAP_WEB_SERVICE_KEY = 'YOUR_AMAP_WEB_SERVICE_KEY'
