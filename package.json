{
  "name": "mini-program-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Mini program monorepo using pnpm workspaces",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" --filter \"./packages/*\" dev",
    "build": "pnpm --filter \"./apps/*\" --filter \"./packages/*\" build",
    "test": "pnpm --filter \"./apps/*\" --filter \"./packages/*\" test",
    "lint": "pnpm --filter \"./apps/*\" --filter \"./packages/*\" lint",
    "dev:waisik": "pnpm --filter waisik dev:mp-weixin",
    "build:waisik": "pnpm --filter waisik build:mp-weixin"
  },
  "keywords": [
    "monorepo",
    "pnpm",
    "mini-program"
  ],
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.10.0"
}
