{
  "name": "mini-program-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Mini program monorepo using pnpm workspaces",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm --filter \"./apps/*\" build",
    "test": "pnpm --filter \"./apps/*\" test",
    "lint": "pnpm --filter \"./apps/*\" lint",
    "dev:waisik": "pnpm --filter waisik dev:mp-weixin",
    "build:waisik": "pnpm --filter waisik build:mp-weixin",
    "prepare": "husky"
  },
  "keywords": [
    "monorepo",
    "pnpm",
    "mini-program"
  ],
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.10.0",
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10"
  },
  "pnpm": {
    "overrides": {
      "unconfig": "7.3.2"
    }
  }
}
